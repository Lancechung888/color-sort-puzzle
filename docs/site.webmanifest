    },
    {
      "src": "screenshots/narrow-03-daily.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Daily Challenge — Crowded, Remixed, or Pressure"
    }
  ],
  "shortcuts": [
