{
  "name": "color-sort-puzzle",
  "version": "1.0.4",
  "description": "彩管分類 ColorTube Sort — hybrid-casual tube sorting puzzle",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8765",
    "serve": "python3 -m http.server 8765",
    "build:www": "bash scripts/sync-www.sh",
    "cap:sync": "npm run build:www && npx cap sync",
    "cap:android": "npm run build:www && npx cap open android",
    "cap:add:android": "npx cap add android",
    "postinstall": "echo \"Run: npm run build:www && npx cap sync (after npx cap add android)\"",
    "aab:internal": "bash scripts/build-internal-aab.sh",
    "native:check": "node scripts/native-wiring-check.js",
    "accept": "node scripts/acceptance-check.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.3",
    "@capgo/native-purchases": "^6.0.42"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0"
  }
}
